#######################################################################
# Logging / server
#######################################################################
WIP_ANALYSIS_LOG_LEVEL=INFO
WIP_ANALYSIS_PORT=8724

#######################################################################
# Postgres connection pool / async writers
#######################################################################
WIP_ANALYSIS_DB_POOL_MIN_SIZE=16
WIP_ANALYSIS_DB_POOL_MAX_SIZE=96
WIP_ANALYSIS_DB_WRITER_WORKERS=64

#######################################################################
# Concurrency - worker pools (each must be >= 1)
#######################################################################
# Threads computing per-snapshot lot progress in lot-level HWM history.
WIP_ANALYSIS_LOT_HISTORY_WORKERS=64
# Threads for stage-level lot-progress recompute (lot_progress_readiness). (code default 8)
WIP_ANALYSIS_LOT_PROGRESS_RECALC_WORKERS=64

#######################################################################
# CP-SAT solver
#######################################################################
# Cap on concurrently-running CP-SAT solves across the process. (code default 6)
WIP_ANALYSIS_MAX_PARALLEL_SOLVERS=24
# num_search_workers per solve. (code default 8)
WIP_ANALYSIS_SOLVER_WORKERS=8
# Per-solve wall-clock budget, seconds. (code default 180; aggregate path uses 300)
# WARNING: 1s is very aggressive and intended for debugging/tight feedback only.
WIP_ANALYSIS_SOLVER_TIMEOUT=300
# Optional JSON object mapping product IDs to authoritative primary paths. An
# exact product ID wins over the optional wildcard fallback. Matching products
# skip path clustering and CP-SAT optimization. Empty/unset keeps automatic discovery.
WIP_ANALYSIS_PRESET_PRIMARY_PATHS={"PRODUCT_A":["STAGE_10","STAGE_20"],"*":["STAGE_10","STAGE_30"]}
# Max Iterations allowed when solving ridge regression for stage duration percentage. (default: 2000)
WIP_ANALYSIS_STAGE_DUR_SOLVER_MAXITER=20000

#######################################################################
# Inference / batching
#######################################################################
WIP_ANALYSIS_INFERENCE_BATCH_SIZE=65536
# Cross-request batching: how many queued requests fold into one forward pass, and
# how long the batch worker lingers (seconds) collecting same-split_time requests.
# These help throughput when many DIFFERENT lots are queried at the SAME split_time.
WIP_ANALYSIS_INFERENCE_MAX_BATCH_REQUESTS=96
WIP_ANALYSIS_INFERENCE_BATCH_WAIT_SECONDS=0.02

#######################################################################
# Lot-level HWM / path-selection tuning
#######################################################################
# Facility-context models only: snapshot look-back window (days) for the multi-lot
# set-level features. Lotwise models ignore this (they use full single-lot history). (code default 30)
WIP_ANALYSIS_FACILITY_SNAPSHOT_WINDOW_DAYS=30
# Min fraction of a lot's distinct observed stages a path candidate must cover to be
# eligible; 1.0 = must contain every observed stage. (code default 0.9)
WIP_ANALYSIS_LOT_PATH_COVERAGE_THRESHOLD=0.9
# Path-candidate cache: tolerate a cached path computed up to N days BEFORE the cut
# (older data only - never future, so no time-travel). 0 = strict (recompute every cut).
# Raise it (e.g. 7) to reuse a recent path across nearby cuts and cut redundant
# clustering/solver work in lot-history reconstruction.
WIP_ANALYSIS_PATH_STALENESS_TOLERANCE_DAYS=0
# Insufficient-history early-out: minimum distinct snapshot observations (created_at timestamps,
# NOT calendar days) a product must have up to the cut before we compute its primary path /
# durations. Below this, the lot returns observed stages only + a response-level note (no
# degenerate single-instant path). Inclusive: N means "need >= N"; 1 (or 0) disables. (code default 2)
WIP_ANALYSIS_MIN_PRODUCT_SNAPSHOTS=2
# Minimum primary-path stage duration share in percentage points on a 0..100 scale.
# -1 = auto floor: 10 / path_len percentage points per stage, equivalent to a
# total 10% floor budget spread across the path. Set e.g. 0.05 for an explicit
# 0.05% minimum share per stage.
WIP_ANALYSIS_MIN_STAGE_PCT=-1
