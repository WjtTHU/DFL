{# Product-specific data query template #}
SELECT
    {{ columns.product_id }} AS product_id,
    {{ columns.lot_id }} AS lot_id,
    {{ columns.lot_status }} AS lot_status,
    {{ columns.stage }} AS stage,
    {{ columns.current_wafer_qty }} AS current_wafer_qty,
    {{ columns.created_at }} AS created_at
FROM {{ tables.snapshot_table }}
WHERE 1=1

    {% if product_id %}
    AND {{ columns.product_id }} = {{ product_id|sql }}
    {% endif %}

    {% if include_parent_filter %}
    AND {{ columns.lot_id }} = {{ columns.parent_lot_id }}
    {% endif %}

    {% if path_start_time %}
    AND {{ columns.created_at }} >= {{ path_start_time|sql }}
    {% endif %}

    {% if path_end_time %}
    AND {{ columns.created_at }} <= {{ path_end_time|sql }}
    {% endif %}

ORDER BY
    {{ columns.product_id }},
    {{ columns.lot_id }},
    {{ columns.parent_lot_id }},
    {{ columns.created_at }}
