SELECT DISTINCT
  s.{{ columns.lot_id }} AS lot_id,
  s.{{ columns.product_id }} AS product_id,
  s.{{ columns.created_at }} AS created_at
FROM {{ tables.snapshot_table }} s
WHERE s.{{ columns.stage }} IS NOT NULL
  AND s.{{ columns.lot_id }} = s.{{ columns.parent_lot_id }}
  {% if product_ids %}
  AND s.{{ columns.product_id }} IN {{ product_ids|sql }}
  {% endif %}
  {% if lot_ids %}
  AND s.{{ columns.lot_id }} IN {{ lot_ids|sql }}
  {% endif %}
  {% if snapshot_start %}
  AND s.{{ columns.created_at }} >= {{ snapshot_start|sql }}
  {% endif %}
  {% if snapshot_end %}
  AND s.{{ columns.created_at }} <= {{ snapshot_end|sql }}
  {% endif %}
ORDER BY
  s.{{ columns.lot_id }} ASC,
  s.{{ columns.created_at }} ASC
{% if query_limit %}
LIMIT {{ query_limit }}
{% endif %}
